# Copy to terraform.tfvars and adjust. terraform.tfvars is gitignored and is
# excluded from VCS pushes, so it never lands in a pull request.

project_name = "synfra-app"
environment  = "dev"
aws_region   = "us-east-1"

vpc_cidr           = "10.0.0.0/16"
public_subnet_cidr = "10.0.1.0/24"
assign_public_ip   = true

# Narrow this to your office/VPN range — the default exposes the port to the
# whole internet.
ingress_cidr = "0.0.0.0/0"
app_port     = 80

instance_type    = "t3.micro"
root_volume_size = 20

tags = {
  Owner      = "platform-team"
  CostCenter = "engineering"
}
